# Copy to .env and fill in to send real emails.
# Without these values, Send Email runs in simulated mode (logs only).
SMTP_USER=
SMTP_PASS=

# Optional overrides (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=
# PORT=3000
# FLOWLITE_DB=/path/to/flowlite.db
# FLOWLITE_ALLOW_PRIVATE=0